+package me.champdev.weblock;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * SubDL's subtitle search (subdl.com, a user-supplied API key in Settings): Sinhala and English files for an IMDb
+ * title or episode, returned the same shape as {@link SubOs.Result} so Subs.search can merge them. Downloads are
+ * ZIPs, which {@link SubFetch} already unpacks. Android-free; the caller supplies the connection.
+ */
+final class SubDl {
+    static final String BASE = "https://api.subdl.com/api/v1/subtitles?";
+    static final int MAX_ANSWER = 4 * 1024 * 1024;
+
+    /** The key the user typed in Settings (empty = SubDL stays off). */
+    static String key() {
+        return App.prefs.getString("subdlKey", "");
+    }
+
+    static void setKey(String key) {
+        App.prefs.edit().putString("subdlKey", key == null ? "" : key.trim()).apply();
+    }
+
+    /** One file SubDL offered. */
+    static final class Result {
+        String url, lang, release, format;
+        boolean hearingImpaired;
+    }
+
+    /** Subs.Sub-shaped search: the languages are SubDL's own codes; Sinhala is "si", English "en". */
+    static List<Result> search(SubOs.Http http, String imdb, int season, int episode, String lang) throws IOException {
+        String digits = imdb == null ? "" : imdb.trim().replaceFirst("^(?i)tt", "");
+        if (!digits.matches("\\d{1,9}")) throw new IOException("bad IMDb id: " + imdb);
+        String key = key();
+        if (key.isEmpty()) return new ArrayList<>();   // no key, no ask — never a failure for the caller
+        String code = lang == null ? "" : lang.trim().toLowerCase(Locale.ROOT);
+        // SubDL's Sinhala code is "si" where OpenSubtitles' is "sin"; anything else passes through as given.
+        if (code.equals("sin")) code = "si";
+        StringBuilder u = new StringBuilder(BASE)
+            .append("imdb_id=tt").append(digits)
+            .append("&key=").append(key)
+            .append("&dl=1&languages=").append(code.isEmpty() ? "si,en" : code);
+        if (season > 0 || episode > 0) {
+            u.append("&season=").append(Math.max(0, season)).append("&episode=").append(Math.max(0, episode));
+        }
+        String body;
+        try (InputStream in = http.open(u.toString())) {
+            body = new String(SubOs.read(in, MAX_ANSWER, "answer"), java.nio.charset.StandardCharsets.UTF_8).trim();
+        }
+        List<Result> out = new ArrayList<>();
+        try {
+            JSONObject j = new JSONObject(body);
+            JSONArray a = j.optJSONArray("subtitles");
+            if (a != null) {
+                for (int i = 0; i < a.length() && out.size() < 40; i++) {
+                    JSONObject s = a.optJSONObject(i);
+                    if (s == null) continue;
+                    String dl = s.optString("url", "");
+                    if (dl.isEmpty()) continue;
+                    Result r = new Result();
+                    r.url = dl.startsWith("/") ? "https://dl.subdl.com" + dl : dl;
+                    r.lang = s.optString("language", code);
+                    r.release = s.optString("release_name", s.optString("name", ""));
+                    r.format = "srt";
+                    r.hearingImpaired = false;
+                    out.add(r);
+                }
+            }
+        } catch (JSONException e) {
+            throw new IOException("bad SubDL answer: " + e.getMessage());
+        }
+        return out;
+    }
+}
