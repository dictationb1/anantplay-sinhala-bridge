+                s.encoding = "";
+                s.hearingImpaired = r.hearingImpaired;
+                if (!s.url.isEmpty() && !out.contains(s)) out.add(s);
+            }
+        } catch (java.io.IOException ignored) { }
         return asked ? out : null;
     }
 
diff --git a/test/SubDlTest.java b/test/SubDlTest.java
new file mode 100644
index 0000000..ad44646
--- /dev/null
+++ b/test/SubDlTest.java
@@ -0,0 +1,112 @@
+// Tests SubDl.java (SubDL subtitle provider behind a user key). From the project folder, with the org.json jar:
+// javac --release 8 -cp $JSON -d /tmp/subdl $(find test/stubs -name '*.java') src/me/champdev/weblock/SubOs.java src/me/champdev/weblock/SubDl.java test/SubDlTest.java && java -cp /tmp/subdl:$JSON me.champdev.weblock.SubDlTest
+// The whole test is offline: the Http connection is a stub returning synthetic answers, and the key rides the
+// same App.prefs stub the other JVM tests use.
+package me.champdev.weblock;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+
+public class SubDlTest {
+    static int fails;
+
+    static void check(String name, Object got, Object want) {
+        if (got == null ? want != null : !got.equals(want)) { fails++; System.out.println("FAIL " + name + ": got " + got + " want " + want); }
+    }
+
+    /** Serves one canned body per call, and records every URL asked. */
+    static class Http implements SubOs.Http {
+        String asked;
+        String serve = "";
+
+        public InputStream open(String url) throws IOException {
+            asked = url;
+            if (serve.startsWith("!")) throw new IOException("offline");
+            return new ByteArrayInputStream(serve.getBytes(StandardCharsets.UTF_8));
+        }
+    }
+
+    static String answer(String... files) {
+        JSONObject j = new JSONObject();
+        JSONArray a = new JSONArray();
+        for (String f : files) {
+            JSONObject o = new JSONObject();
+            o.put("url", "/subtitle/" + f + ".zip");
+            o.put("language", "si");
+            o.put("release_name", f);
+            a.put(o);
+        }
+        j.put("subtitles", a);
+        return j.toString();
+    }
+
+    public static void main(String[] args) throws Exception {
+        System.out.println("SubDlTest");
+        Http http = new Http();
+
+        // 1. no key → empty list, and NOTHING asked from the network
+        SubDl.setKey("");
+        List<SubDl.Result> none = SubDl.search(http, "tt0903747", 1, 1, "sin");
+        check("no key returns empty", none.size(), 0);
+        check("no key asks nothing", http.asked, null);
+
+        // 2. key + a Sinhala answer → url, lang, release mapped; sin asked as si
+        SubDl.setKey("TESTKEY");
+        http.serve = answer("dark.s01e01.si");
+        List<SubDl.Result> one = SubDl.search(http, "tt0903747", 1, 1, "sin");
+        check("one result", one.size(), 1);
+        check("url is dl host", one.get(0).url, "https://dl.subdl.com/subtitle/dark.s01e01.si.zip");
+        check("lang kept", one.get(0).lang, "si");
+        check("release kept", one.get(0).release, "dark.s01e01.si");
+        check("sin mapped to si in url", http.asked.contains("languages=si"), true);
+        check("imdb sent", http.asked.contains("imdb_id=tt0903747"), true);
+        check("key sent", http.asked.contains("key=TESTKEY"), true);
+        check("season/episode sent", http.asked.contains("season=1") && http.asked.contains("episode=1"), true);
+
+        // 3. movie (season 0) → no season/episode params
+        http.serve = answer("movie.si");
+        List<SubDl.Result> movie = SubDl.search(http, "tt0133093", 0, 0, "si");
+        check("movie no season param", http.asked.contains("season="), false);
+        check("movie result url", movie.get(0).url, "https://dl.subdl.com/subtitle/movie.si.zip");
+
+        // 4. season pack (season > 0, episode 0) → still a series query, season only
+        http.serve = answer("pack.si");
+        SubDl.search(http, "tt0903747", 2, 0, "si");
+        check("season-only query", http.asked.contains("season=2") && http.asked.contains("episode=0"), true);
+
+        // 5. bad IMDb → IOException, never a network call
+        http.asked = null;
+        try { SubDl.search(http, "nonsense", 0, 0, "si"); fails++; System.out.println("FAIL bad imdb: no exception"); }
+        catch (IOException e) { check("bad imdb asked nothing", http.asked, null); }
+
+        // 6. not JSON → IOException (a quota page must not pass as an empty-but-fine answer)
+        http.serve = "<html>quota exceeded</html>";
+        try { SubDl.search(http, "tt0903747", 1, 1, "si"); fails++; System.out.println("FAIL html answer: no exception"); }
+        catch (IOException e) { }
+
+        // 7. offline → IOException
+        http.serve = "!offline";
+        try { SubDl.search(http, "tt0903747", 1, 1, "si"); fails++; System.out.println("FAIL offline: no exception"); }
+        catch (IOException e) { }
+
+        // 8. empty list (no subtitles key) → empty, fine
+        http.serve = "{}";
+        List<SubDl.Result> empty = SubDl.search(http, "tt0903747", 1, 1, "si");
+        check("empty answer empty list", empty.size(), 0);
+
+        // 9. key trimming + clearing
+        SubDl.setKey("  KEY2  ");
+        check("key trimmed", SubDl.key(), "KEY2");
+        SubDl.setKey(null);
+        check("null key cleared", SubDl.key(), "");
+
+        System.out.println(fails == 0 ? "OK" : fails + " FAILURES");
+        if (fails > 0) System.exit(1);
+    }
+}
