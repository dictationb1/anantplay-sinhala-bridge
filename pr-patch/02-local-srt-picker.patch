+    /** A local file's bytes, normalized exactly like a fetched one (BOM stripped, newlines unified, UTF-8, ext sniffed) —
+     * the local .srt picker's path. Throws (a null return never happens) when the bytes are not a subtitle. */
+    static Fetched normalize(byte[] b, String name) throws IOException {
+        String entryExt = "";
+        if (b.length > 1 && (b[0] & 0xff) == 0x1f && (b[1] & 0xff) == 0x8b) {
+            try (InputStream z = new GZIPInputStream(new ByteArrayInputStream(b))) {
+                b = SubOs.read(z, MAX, "unpacked subtitle");
+            }
+        } else if (b.length > 3 && b[0] == 'P' && b[1] == 'K' && b[2] == 3 && b[3] == 4) {
+            Object[] best = unzip(b);
+            b = (byte[]) best[0];
+            entryExt = (String) best[1];
+        }
+        String x = name == null ? "" : name.toLowerCase(Locale.ROOT);
+        x = x.lastIndexOf('.') < 0 ? "" : x.substring(x.lastIndexOf('.') + 1);
+        if (x.equals("ass") || x.equals("ssa")) entryExt = x;
+
+        Charset cs = pick(b, null, null);
+        String t = new String(b, cs);
+        if (t.startsWith("﻿")) t = t.substring(1);
+        t = t.replace("\r\n", "\n").replace('\r', '\n');
+        int end = t.length();
+        while (end > 0 && Character.isWhitespace(t.charAt(end - 1))) end--;
+        t = t.substring(0, end);
+
+        String ext = t.startsWith("WEBVTT") ? "vtt" : t.contains("[Script Info]") || entryExt.equals("ass") || entryExt.equals("ssa") ? "ass" : "srt";
+        if (!ext.equals("ass") && !t.contains("-->")) throw new IOException("not a subtitle file");
+
+        File dir = new File(App.app.getCacheDir(), "subs");
+        if (!dir.isDirectory() && !dir.mkdirs()) throw new IOException("cannot create " + dir);
+        File out = File.createTempFile("local", "." + ext, dir);
+        try (OutputStream o = new FileOutputStream(out)) {
+            o.write(t.getBytes(StandardCharsets.UTF_8));
+        }
+        return result(out, ext, "UTF-8");
+    }
